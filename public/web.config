<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Frame-Options" />
        <remove name="X-XSS-Protection" />
        <remove name="X-Content-Type-Options" />
        <!-- <add name="Strict-Transport-Security" value="max-age=31536000;" /> -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' https://www.googletagmanager.com https://code.jquery.com https://smtpjs.com 'unsafe-inline' https://static.hotjar.com http://static.hotjar.com http://code.jquery.com; style-src 'self' https://fonts.googleapis.com https://*.mapbox.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; media-src 'self' data:; img-src 'self' data: https://*.google-analytics.com https://*.mapbox.com https://apps.who.int https://iris.who.int; connect-src 'self' https://*.google-analytics.com https://*.mapbox.com https://*.tiles.mapbox.com https://*.arcgis.com https://xmart-api-public-uat.who.int https://extranet.who.int https://apps-dev.who.int https://apps.who.int; frame-ancestors 'self';" />
        <add name="Cache-Control" value="no-store, no-cache, must-revalidate, proxy-revalidate" />
        <add name="X-XSS-Protection" value="0" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>